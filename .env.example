# ─────────────────────────────────────────────────────────────────────────────
# Softly — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure na Vercel (produção).
# Nenhuma delas é obrigatória para rodar o site: sem elas, o formulário grava
# o lead no log do servidor e o analytics simplesmente não é injetado.
# ─────────────────────────────────────────────────────────────────────────────

# URL do site (canonical, OG, sitemap e robots). Sempre com https://
# Lida apenas no servidor — por isso NÃO leva o prefixo NEXT_PUBLIC_.
SITE_URL="https://softly.com.br"

# ── Analytics ────────────────────────────────────────────────────────────────
# Só disparam depois do aceite no banner LGPD (Consent Mode v2 já sobe negado).
NEXT_PUBLIC_GA_ID=""            # ex.: G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=""    # ex.: 123456789012345

# ── Entrega dos leads (escolha uma, as duas ou nenhuma) ──────────────────────
# 1. Webhook genérico: recebe o lead em JSON (Make, n8n, Zapier, CRM próprio)
CONTACT_WEBHOOK_URL=""
NEWSLETTER_WEBHOOK_URL=""

# 2. E-mail via Resend (https://resend.com) — sem SDK, só a chave
RESEND_API_KEY=""
CONTACT_TO_EMAIL="contato@softly.com.br"
CONTACT_FROM_EMAIL="Softly <site@softly.com.br>"
